# Copy to .env next to wsgi.py (it is read at start-up), or set these in your host's environment.
# Real environment variables win over this file. Never commit real values. Leave a value blank to leave it unset.
PBF_ENV=development            # set to "production" when live (enables secure cookies + HSTS)
SECRET_KEY=                    # REQUIRED in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SITE_URL=https://pbf.studio    # used for sitemap, canonical and share links (set once the domain is live)
PBF_DATA_DIR=./data            # database + uploads live here; back this folder up
PROXY_HOPS=0                   # set to 1 behind one reverse proxy (nginx, Cloudflare Tunnel, most PaaS)

# First admin (one-off): set a long random token, visit /admin/setup, create the admin, then remove it.
# Alternative: flask --app wsgi create-admin you@example.com
SETUP_TOKEN=

# Public contact details (can also be edited in Admin > Settings; settings saved there win)
CONTACT_EMAIL=
WHATSAPP_NUMBER=               # international format, e.g. +254...
INSTAGRAM_URL=
TIKTOK_URL=

# Enquiry email (optional; without it enquiries are still saved and visible in admin)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PBF Studio <no-reply@pbf.studio>
SMTP_STARTTLS=1
NOTIFY_EMAIL=                  # where new-enquiry alerts go (or set in Admin > Settings)
NOTIFY_WEBHOOK_URL=            # optional Slack/Discord-compatible incoming webhook

# Spam protection (optional; honeypot, timing check and rate limits are always on)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Limits
MAX_IMAGE_MB=15
MAX_VIDEO_MB=200
MAX_ATTACHMENT_MB=8
SESSION_HOURS=8
